#!/bin/sh
# Re-check the status document against git after a commit, merge or rewrite.
#
#     tools/hooks/extant-verify
#     tools/hooks/extant-verify --after-rewrite <amend|rebase>
#
# Installed into .git/hooks/post-commit, post-merge and post-rewrite by
# tools/hooks/install. Advisory only: it never blocks or fails an operation,
# because the commit it is checking has already happened.
#
# Why this exists: /extant gates its OWN commit on the validator, but nothing
# re-checked the document afterwards. A later commit can falsify a claim that
# was true when written. That is not hypothetical - merging the status branch
# on 2026-07-21 turned "not yet integrated" false the instant it landed, and
# only a manual --verify noticed. This turns "the validator was run" from a
# claim into an observation.
#
# WHY post-rewrite NEEDS ITS OWN ENTRY POINT
#
# A rewrite is the event that falsifies the most claims at once: every commit
# gets a new id, so every document citing one goes wrong in the same instant.
# Measured 2026-08-30 on a real agent-written project, 12 of its 12 dead SHA
# references came from a single `git filter-repo` run.
#
# Wiring post-rewrite to the plain entry point would have installed a hook that
# never ran. Measured on git 2.53.0:
#
#   git rebase   post-commit fires ONCE PER REPLAYED COMMIT and is correctly
#                suppressed by the rebase-state guard below; post-rewrite then
#                fires once - and `rebase-merge/` IS STILL PRESENT when it
#                does, so the same guard would have skipped it too.
#   git amend    post-commit fires and runs the check, then post-rewrite fires
#                for the same event - which is why --after-rewrite amend exits
#                without re-running it. Two identical reports for one operation
#                is how a hook teaches people to stop reading it.
#
# So the flag does exactly two things: it suspends the rebase-state guard,
# because here that state means the rebase FINISHED rather than that one is in
# progress, and it declines the amend case that post-commit already covered.
#
# WHAT THIS HOOK CAN AND CANNOT SEE, measured rather than assumed
#
# It fires on a rebase - confirmed end to end, real hooks, real rebase, git
# 2.53.0 - and the check it runs finds nothing, because after a LOCAL rebase
# the old commits still resolve. The reflog holds them, so `git cat-file -e`
# succeeds and `dead-sha` has no finding to make. The commit is no longer an
# ancestor of any branch, which is what actually makes the claim false, and no
# rule here asks that question.
#
# So be honest about the split:
#
#   filter-repo   REAL value. It expires the old objects, so the references
#                 genuinely stop resolving - which is the case measured on a
#                 real project, 12 of 12 dead SHAs from one such run.
#   rebase/amend  The hook runs and correctly reports nothing, until a `gc`
#                 expires the reflog. Nothing is attached to gc, so in
#                 practice the breakage surfaces on the next fresh clone.
#
# Two things follow, and neither is built here because neither is measured:
# a rule asking whether a cited commit is still REACHABLE would catch the
# rebase case at the moment it happens; and git feeds this hook
# `<old-sha> <new-sha>` pairs on stdin, byte-for-byte the commit-map format
# `--sha-map` already parses, which is the only record a rebase leaves. The
# hook currently drains those pairs and discards them. Persisting them would
# let a finding name the replacement after a rebase the way it already does
# after filter-repo. Measure how often a rebase is the cause before building
# either.

set -u

# --- two pipelines that became builtins --------------------------------------
#
# About half of what a commit pays for this hook is SCAFFOLDING rather than
# validation. Measured on this machine with the CURRENT hook, median of 7: a
# clean document costs 548 ms of which 234 is `--verify` and 314 is shell
# around it (57 per cent), and a document with 40 findings costs 782 ms of
# which 401 is `--verify` and 381 is shell (49 per cent).
#
# The two largest addressable pieces were both pipelines spawning processes to
# do work the shell can do with none. Per call, median of 40 under `sh`:
#
#     reading primary_doc   `sed` piped to `head`      91.2 ms ->  1.6 ms
#     formatting findings   `grep -c`, `head`, `sed`  158.9 ms -> 69.9 ms
#
# End to end that is 706 ms to 576 on a clean document and 849 to 643 on one
# with 40 findings, both median of 7, both hooks printing byte-identical
# output.
#
# The second row keeps ONE of its three processes on purpose, and the reason is
# on `extant_findings_summary` below: the version with no processes at all is
# silently wrong above 4 KB under one shell and quadratic under the other.
#
# On Linux each of these is a few milliseconds and none of it would register.
# On Windows every one is a Git Bash process - measured here at 28.75 ms for a
# bare `sh -c :` - which is why this is a Windows finding and why the numbers
# beside it say which platform they came from.
#
# BOTH FUNCTIONS SET VARIABLES RATHER THAN PRINTING. Reading them back with
# `$(...)` would fork a subshell, which is most of the process this is trying
# not to spawn - and for the formatter it would lose COUNT outright, because a
# subshell's variables do not reach its parent. That is not hypothetical: the
# first version of the formatter ran its loop in a pipeline, lost the count,
# and the test missed it because the test PRINTED the count instead of using it
# afterwards the way the hook does.
#
# tests/test_hook_builtins.py lifts both of these out of this file by name and
# runs them against the pipelines they replace, under `sh` and under `dash`,
# because CI's /bin/sh is dash and these constructs had only ever been
# exercised under Git Bash.

# EXTANT_PRIMARY_DOC := the first `primary_doc` value in the TOML file named by
# $1, or "" when the file names none.
#
# Replaces, exactly:
#
#     sed -n "s/^[[:space:]]*primary_doc[[:space:]]*=[[:space:]]*[\"']\
#     \\([^\"']*\\).*/\\1/p" "$CONFIG" | head -n 1
extant_primary_doc() {
    EXTANT_PRIMARY_DOC=""
    while IFS= read -r _line || [ -n "$_line" ]; do
        # `[[:space:]]` inside a `case` bracket, not a hand-written " |	",
        # so this strips exactly the class the sed pattern did. POSIX bracket
        # expressions carry character classes and both `sh` and `dash` honour
        # them; the test asserts that rather than trusting it.
        while :; do
            case $_line in
                [[:space:]]*) _line=${_line#?} ;;
                *) break ;;
            esac
        done
        case $_line in
            primary_doc*) _rest=${_line#primary_doc} ;;
            *) continue ;;
        esac
        while :; do
            case $_rest in
                [[:space:]]*) _rest=${_rest#?} ;;
                *) break ;;
            esac
        done
        case $_rest in
            =*) _rest=${_rest#=} ;;
            *) continue ;;
        esac
        while :; do
            case $_rest in
                [[:space:]]*) _rest=${_rest#?} ;;
                *) break ;;
            esac
        done
        case $_rest in
            \"*|\'*) _rest=${_rest#?} ;;
            *) continue ;;    # unquoted: the sed pattern required a quote too
        esac
        # The sed capture is `[^"']*`, which stops at the first quote of EITHER
        # kind rather than at the one that opened the value. Cutting at each
        # and keeping the shorter result is that same rule, with no process -
        # and it is the difference between agreeing with the shipped command
        # and agreeing with a plausible description of it.
        _dq=${_rest%%\"*}
        _sq=${_rest%%\'*}
        if [ ${#_dq} -le ${#_sq} ]; then
            EXTANT_PRIMARY_DOC=$_dq
        else
            EXTANT_PRIMARY_DOC=$_sq
        fi
        break                 # `head -n 1`: the FIRST value, not the last
    done < "$1"
}

# COUNT := how many lines of $1 contain a `[`; LISTING := the first five lines
# of $1, each indented by two spaces and newline-terminated.
#
# Replaces two of the three processes in:
#
#     COUNT=$(printf '%s\n' "$OUTPUT" | grep -c '\[' )
#     printf '%s\n' "$OUTPUT" | head -5 | sed 's/^/  /'
#
# `head` and `sed` are gone; `grep -c` STAYS, and that split is the whole
# design rather than a half-finished job. Measured on this machine over 40
# calls on a 20-finding output: 158.9 ms per call to 69.9 under `sh`, 144.7 to
# 56.6 under `dash`.
#
# WHY THE COUNT IS STILL A PROCESS. The first version of this read `$1` through
# a here-document - `done <<EOF` - which is fast and, under the `dash` that
# ships with Git for Windows, SILENTLY WRONG above about 4 KB. Measured, with
# the here-doc inside a shell function: 2691 bytes reads back every line, 5491
# bytes reads back NOTHING, so COUNT came out 0 and the listing empty while
# `--verify` had exited 1. That is a hook reporting "0 unverified claim(s)" on
# a document full of them - the silent wrong answer this project exists to
# refuse, arriving in the one material here with no type checker.
#
# Upstream dash writes a here-doc larger than PIPESIZE to a temp file and would
# probably be fine; that is not knowable from a Windows machine, and an
# implementation whose correctness turns on which shell PORT is installed is
# not one to ship. Counting every line without a process needs a `while` over
# `${_rest#*...}`, which copies the remainder each pass - correct at every size
# under both shells, and O(n^2): 2952 ms at 2000 lines, 19 seconds at 5000.
#
# So the work is split by what each half actually needs. The LISTING needs five
# lines, so parameter expansion runs five times and costs the same whatever the
# output's size. The COUNT needs every line, which is precisely what one `grep`
# process does correctly at any size. Flat cost, no size threshold, no shell
# port to trust.
#
# The two populations are deliberately different and stay different: COUNT is
# findings, the listing is LINES, and a finding that wraps is one of each.
extant_findings_summary() {
    # A literal newline, defined INSIDE the function so that lifting this out
    # by name - which tests/test_hook_builtins.py does - lifts something that
    # runs on its own.
    _LF='
'
    # A subshell for the substitution only. That is not the mistake the loop
    # below avoids: the ASSIGNMENT happens in this shell, so COUNT reaches the
    # caller that needs it twice - once in the header line and once in the `if`
    # after the listing. Running the LOOP in a pipeline is what loses it.
    COUNT=$(printf '%s\n' "$1" | grep -c '\[')
    LISTING=""
    _seen=0
    _rest=$1
    while [ "$_seen" -lt 5 ]; do
        case $_rest in
            *"$_LF"*)
                _line=${_rest%%"$_LF"*}
                _rest=${_rest#*"$_LF"}
                _more=1
                ;;
            *)
                _line=$_rest
                _more=0
                ;;
        esac
        LISTING="$LISTING  $_line$_LF"
        _seen=$((_seen + 1))
        [ "$_more" -eq 1 ] || break
    done
}

AFTER_REWRITE=0
REWRITE_KIND=""
if [ "${1:-}" = "--after-rewrite" ]; then
    AFTER_REWRITE=1
    REWRITE_KIND="${2:-}"
fi

# post-commit already reported this one. See the header.
[ "$AFTER_REWRITE" -eq 1 ] && [ "$REWRITE_KIND" = "amend" ] && exit 0

# Three answers from ONE git process. This hook runs on every commit, and two
# of the three calls this batching removes are a process each, for information
# git will hand over all at once. Split with the shell's own word splitting
# rather than sed, because spending the saving on three more process spawns
# would be worse than not optimising at all.
#
# THE PRICE HERE WAS OUT BY ABOUT 3.5x and is corrected rather than left,
# because a decision priced wrongly is one nobody can re-derive. It read
# "roughly 90 ms" per Windows subprocess and claimed this saved about 170 ms.
# Measured on this machine, median of 20: a bare `sh -c :` costs 28.75 ms and a
# `git rev-parse` costs 28.27, so the batch saves about 57 ms. The decision is
# still the right one - 52 ms on every commit, for one line of word splitting -
# but it is a smaller win than the file claimed, and the same measurement is
# what moved the real target to the two pipelines above.
#
# The three are NOT interchangeable:
#
#   --git-dir         this worktree's own git directory. MERGE_HEAD and the
#                     rebase state live here, per worktree.
#   --show-toplevel   the checkout being committed to, which is the branch
#                     whose claims are being validated. Reading the document
#                     from the main working tree instead would validate some
#                     other branch's file, and would break outright when the
#                     main tree sits on a branch predating the tool (observed
#                     2026-07-21, 180 commits behind).
#   --git-common-dir  the shared directory, whose parent is the MAIN working
#                     tree. Only the interpreter comes from there, because a
#                     virtualenv is gitignored and exists nowhere else.
_paths=$(git rev-parse --path-format=absolute \
             --git-dir --show-toplevel --git-common-dir 2>/dev/null) || exit 0
_oldifs=$IFS
IFS='
'
# shellcheck disable=SC2086
set -- $_paths
IFS=$_oldifs
[ "$#" -eq 3 ] || exit 0
GIT_DIR_PATH=$1
TOPLEVEL=$2
COMMON_DIR=$3
MAIN_TREE=$(dirname "$COMMON_DIR")

# Never disturb an in-progress operation. A rebase or cherry-pick commits
# repeatedly and would fire this on every step; MERGE_HEAD means a merge is
# still resolving.
#
# Suspended after a rewrite, and only there: post-rewrite runs once, at the
# END, and git has not torn the state directory down yet. Reading it as "a
# rebase is in progress" is how this hook would have been installed and inert.
if [ "$AFTER_REWRITE" -eq 0 ]; then
    [ -d "$GIT_DIR_PATH/rebase-merge" ] && exit 0
    [ -d "$GIT_DIR_PATH/rebase-apply" ] && exit 0
fi
[ -f "$GIT_DIR_PATH/MERGE_HEAD" ] && exit 0

# Virtualenv layout differs by platform: Windows uses Scripts/python.exe, POSIX
# uses bin/python. This previously hardcoded the Windows form and then skipped
# silently when it was absent - so on macOS and Linux the hook installed
# cleanly, found nothing, and validated NOTHING on every commit, while looking
# perfectly healthy. Try every layout, then PATH, and say so out loud if none
# is found.
PY=""
for candidate in \
    "$MAIN_TREE/.venv/Scripts/python.exe" \
    "$MAIN_TREE/.venv/bin/python" \
    "$MAIN_TREE/.venv/bin/python3"; do
    if [ -x "$candidate" ]; then
        PY="$candidate"
        break
    fi
done
if [ -z "$PY" ]; then
    PY=$(command -v python3 2>/dev/null || command -v python 2>/dev/null || true)
fi

TOOL="$TOPLEVEL/tools/extant_collect.py"

# The document name is per-project and lives in .extant.toml. This line used to
# hardcode NEXT_SESSION.md, so a repo that called its document anything else fell
# straight through the "nothing to validate" exit below and this hook did nothing
# for its entire installed life - silently, because that exit is the legitimate
# one. The irony being that --verify, invoked ten lines further down, reads the
# config correctly; only the guard in front of it did not.
DOC_NAME=NEXT_SESSION.md
CONFIGURED=0
CONFIG="$TOPLEVEL/.extant.toml"
if [ -f "$CONFIG" ]; then
    extant_primary_doc "$CONFIG"
    if [ -n "$EXTANT_PRIMARY_DOC" ]; then
        DOC_NAME="$EXTANT_PRIMARY_DOC"
        CONFIGURED=1
    fi
fi
DOC="$TOPLEVEL/$DOC_NAME"

# A checkout predating the tool is a legitimate silent skip.
[ -f "$TOOL" ] || exit 0

# A missing DOCUMENT is only legitimately silent when nothing claimed one exists.
# If .extant.toml names it, its absence means this commit went unvalidated, and
# that is a finding rather than a no-op.
if [ ! -f "$DOC" ]; then
    if [ "$CONFIGURED" -eq 1 ]; then
        echo "[extant] .extant.toml names '$DOC_NAME', but no such file exists" >&2
        echo "[extant]   nothing was validated for this commit" >&2
    fi
    exit 0
fi

# A MISSING INTERPRETER IS NOT. The document exists and the tool is present, so
# something should have been checked. Skipping quietly here is what made this
# hook a no-op on POSIX for its entire existence.
if [ -z "$PY" ]; then
    echo "[extant] cannot validate ${DOC##*/}: no Python interpreter found." >&2
    echo "[extant]   tried .venv/{Scripts/python.exe,bin/python,bin/python3}" >&2
    echo "[extant]   under $MAIN_TREE, then python3/python on PATH." >&2
    exit 0
fi

# SYNCHRONOUS, AND IN THE FOREGROUND. Both alternatives were considered and
# both are refused for the same reason rather than for a cost.
#
# Backgrounding this, or deferring it to some later trigger, would decouple the
# report from the commit that caused it - and the whole reason this hook exists
# is to turn "the validator was run" from a claim into an observation. A report
# that arrives detached from its commit is a claim again.
#
# It is also where the remaining time actually goes, and that is worth stating
# beside the two pipelines above rather than leaving someone to rediscover it:
# on a trivial document the interpreter floor is 35 ms, imports are 141 ms, and
# the validation itself is 35 ms. A commit pays more to START Python than to
# use it, and nothing in this file changes that.
OUTPUT=$("$PY" "$TOOL" --verify --repo "$TOPLEVEL" 2>&1)
STATUS=$?

if [ "$STATUS" -ne 0 ]; then
    extant_findings_summary "$OUTPUT"
    echo "[extant] $DOC_NAME has $COUNT unverified claim(s):"
    printf '%s' "$LISTING"
    if [ "$COUNT" -gt 5 ]; then
        echo "  ... run: \"$PY\" tools/extant_collect.py --verify"
    fi
fi

# Advisory: the commit already happened, so never fail.
exit 0
