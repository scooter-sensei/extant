# The shell hooks MUST keep LF endings on every platform.
#
# Git checks these out on Windows too, and with core.autocrlf=true a clone would
# rewrite them to CRLF. A shebang line ending in CR makes the kernel look for an
# interpreter named "/bin/sh\r", which fails with an error naming a path that
# looks perfectly correct. Without this file the hooks are LF only by accident
# of whatever the cloner's git happens to be configured to do.
payload/hooks/* text eol=lf
*.sh text eol=lf

# The command template is written into a target repo verbatim; keep it stable.
payload/commands/*.template text eol=lf
