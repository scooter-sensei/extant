#!/bin/sh
# Re-check the status document against git after a commit, merge or rewrite.
#
#     tools/hooks/extant-verify
#     tools/hooks/extant-verify --after-rewrite <amend|rebase>
#
# Installed into .git/hooks/post-commit, post-merge and post-rewrite by
# tools/hooks/install. Advisory only: it never blocks or fails an operation,
# because the commit it is checking has already happened.
#
# Why this exists: /extant gates its OWN commit on the validator, but nothing
# re-checked the document afterwards. A later commit can falsify a claim that
# was true when written. That is not hypothetical - merging the status branch
# on 2026-07-21 turned "not yet integrated" false the instant it landed, and
# only a manual --verify noticed. This turns "the validator was run" from a
# claim into an observation.
#
# WHY post-rewrite NEEDS ITS OWN ENTRY POINT
#
# A rewrite is the event that falsifies the most claims at once: every commit
# gets a new id, so every document citing one goes wrong in the same instant.
# Measured 2026-08-30 on a real agent-written project, 12 of its 12 dead SHA
# references came from a single `git filter-repo` run.
#
# Wiring post-rewrite to the plain entry point would have installed a hook that
# never ran. Measured on git 2.53.0:
#
#   git rebase   post-commit fires ONCE PER REPLAYED COMMIT and is correctly
#                suppressed by the rebase-state guard below; post-rewrite then
#                fires once - and `rebase-merge/` IS STILL PRESENT when it
#                does, so the same guard would have skipped it too.
#   git amend    post-commit fires and runs the check, then post-rewrite fires
#                for the same event - which is why --after-rewrite amend exits
#                without re-running it. Two identical reports for one operation
#                is how a hook teaches people to stop reading it.
#
# So the flag does exactly two things: it suspends the rebase-state guard,
# because here that state means the rebase FINISHED rather than that one is in
# progress, and it declines the amend case that post-commit already covered.
#
# WHAT THIS HOOK CAN AND CANNOT SEE, measured rather than assumed
#
# It fires on a rebase - confirmed end to end, real hooks, real rebase, git
# 2.53.0 - and the check it runs finds nothing, because after a LOCAL rebase
# the old commits still resolve. The reflog holds them, so `git cat-file -e`
# succeeds and `dead-sha` has no finding to make. The commit is no longer an
# ancestor of any branch, which is what actually makes the claim false, and no
# rule here asks that question.
#
# So be honest about the split:
#
#   filter-repo   REAL value. It expires the old objects, so the references
#                 genuinely stop resolving - which is the case measured on a
#                 real project, 12 of 12 dead SHAs from one such run.
#   rebase/amend  The hook runs and correctly reports nothing, until a `gc`
#                 expires the reflog. Nothing is attached to gc, so in
#                 practice the breakage surfaces on the next fresh clone.
#
# Two things follow, and neither is built here because neither is measured:
# a rule asking whether a cited commit is still REACHABLE would catch the
# rebase case at the moment it happens; and git feeds this hook
# `<old-sha> <new-sha>` pairs on stdin, byte-for-byte the commit-map format
# `--sha-map` already parses, which is the only record a rebase leaves. The
# hook currently drains those pairs and discards them. Persisting them would
# let a finding name the replacement after a rebase the way it already does
# after filter-repo. Measure how often a rebase is the cause before building
# either.

set -u

AFTER_REWRITE=0
REWRITE_KIND=""
if [ "${1:-}" = "--after-rewrite" ]; then
    AFTER_REWRITE=1
    REWRITE_KIND="${2:-}"
fi

# post-commit already reported this one. See the header.
[ "$AFTER_REWRITE" -eq 1 ] && [ "$REWRITE_KIND" = "amend" ] && exit 0

# Three answers from ONE git process. This hook runs on every commit, and each
# subprocess costs roughly 90 ms on Windows, so three separate `git rev-parse`
# calls were about 170 ms of pure overhead per commit for information git will
# hand over all at once. Split with the shell's own word splitting rather than
# sed, because spending the saving on three more process spawns would be worse
# than not optimising at all.
#
# The three are NOT interchangeable:
#
#   --git-dir         this worktree's own git directory. MERGE_HEAD and the
#                     rebase state live here, per worktree.
#   --show-toplevel   the checkout being committed to, which is the branch
#                     whose claims are being validated. Reading the document
#                     from the main working tree instead would validate some
#                     other branch's file, and would break outright when the
#                     main tree sits on a branch predating the tool (observed
#                     2026-07-21, 180 commits behind).
#   --git-common-dir  the shared directory, whose parent is the MAIN working
#                     tree. Only the interpreter comes from there, because a
#                     virtualenv is gitignored and exists nowhere else.
_paths=$(git rev-parse --path-format=absolute \
             --git-dir --show-toplevel --git-common-dir 2>/dev/null) || exit 0
_oldifs=$IFS
IFS='
'
# shellcheck disable=SC2086
set -- $_paths
IFS=$_oldifs
[ "$#" -eq 3 ] || exit 0
GIT_DIR_PATH=$1
TOPLEVEL=$2
COMMON_DIR=$3
MAIN_TREE=$(dirname "$COMMON_DIR")

# Never disturb an in-progress operation. A rebase or cherry-pick commits
# repeatedly and would fire this on every step; MERGE_HEAD means a merge is
# still resolving.
#
# Suspended after a rewrite, and only there: post-rewrite runs once, at the
# END, and git has not torn the state directory down yet. Reading it as "a
# rebase is in progress" is how this hook would have been installed and inert.
if [ "$AFTER_REWRITE" -eq 0 ]; then
    [ -d "$GIT_DIR_PATH/rebase-merge" ] && exit 0
    [ -d "$GIT_DIR_PATH/rebase-apply" ] && exit 0
fi
[ -f "$GIT_DIR_PATH/MERGE_HEAD" ] && exit 0

# Virtualenv layout differs by platform: Windows uses Scripts/python.exe, POSIX
# uses bin/python. This previously hardcoded the Windows form and then skipped
# silently when it was absent - so on macOS and Linux the hook installed
# cleanly, found nothing, and validated NOTHING on every commit, while looking
# perfectly healthy. Try every layout, then PATH, and say so out loud if none
# is found.
PY=""
for candidate in \
    "$MAIN_TREE/.venv/Scripts/python.exe" \
    "$MAIN_TREE/.venv/bin/python" \
    "$MAIN_TREE/.venv/bin/python3"; do
    if [ -x "$candidate" ]; then
        PY="$candidate"
        break
    fi
done
if [ -z "$PY" ]; then
    PY=$(command -v python3 2>/dev/null || command -v python 2>/dev/null || true)
fi

TOOL="$TOPLEVEL/tools/extant_collect.py"

# The document name is per-project and lives in .extant.toml. This line used to
# hardcode NEXT_SESSION.md, so a repo that called its document anything else fell
# straight through the "nothing to validate" exit below and this hook did nothing
# for its entire installed life - silently, because that exit is the legitimate
# one. The irony being that --verify, invoked ten lines further down, reads the
# config correctly; only the guard in front of it did not.
DOC_NAME=NEXT_SESSION.md
CONFIGURED=0
CONFIG="$TOPLEVEL/.extant.toml"
if [ -f "$CONFIG" ]; then
    _d=$(sed -n "s/^[[:space:]]*primary_doc[[:space:]]*=[[:space:]]*[\"']\\([^\"']*\\).*/\\1/p" \
         "$CONFIG" | head -n 1)
    if [ -n "$_d" ]; then
        DOC_NAME="$_d"
        CONFIGURED=1
    fi
fi
DOC="$TOPLEVEL/$DOC_NAME"

# A checkout predating the tool is a legitimate silent skip.
[ -f "$TOOL" ] || exit 0

# A missing DOCUMENT is only legitimately silent when nothing claimed one exists.
# If .extant.toml names it, its absence means this commit went unvalidated, and
# that is a finding rather than a no-op.
if [ ! -f "$DOC" ]; then
    if [ "$CONFIGURED" -eq 1 ]; then
        echo "[extant] .extant.toml names '$DOC_NAME', but no such file exists" >&2
        echo "[extant]   nothing was validated for this commit" >&2
    fi
    exit 0
fi

# A MISSING INTERPRETER IS NOT. The document exists and the tool is present, so
# something should have been checked. Skipping quietly here is what made this
# hook a no-op on POSIX for its entire existence.
if [ -z "$PY" ]; then
    echo "[extant] cannot validate ${DOC##*/}: no Python interpreter found." >&2
    echo "[extant]   tried .venv/{Scripts/python.exe,bin/python,bin/python3}" >&2
    echo "[extant]   under $MAIN_TREE, then python3/python on PATH." >&2
    exit 0
fi

OUTPUT=$("$PY" "$TOOL" --verify --repo "$TOPLEVEL" 2>&1)
STATUS=$?

if [ "$STATUS" -ne 0 ]; then
    COUNT=$(printf '%s\n' "$OUTPUT" | grep -c '\[' )
    echo "[extant] $DOC_NAME has $COUNT unverified claim(s):"
    printf '%s\n' "$OUTPUT" | head -5 | sed 's/^/  /'
    if [ "$COUNT" -gt 5 ]; then
        echo "  ... run: \"$PY\" tools/extant_collect.py --verify"
    fi
fi

# Advisory: the commit already happened, so never fail.
exit 0
